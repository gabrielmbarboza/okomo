# ===========================================
# Okomo - Environment Variables (Example)
# ===========================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# Rails
RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true
RAILS_MAX_THREADS=5

# PostgreSQL
POSTGRES_USER=okomo
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=okomo_development

# Database (used by Rails app)
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USERNAME=okomo
DATABASE_PASSWORD=your_secure_password_here
DATABASE_NAME=okomo_development

# Redis
REDIS_URL=redis://redis:6379/0

# Ports (host mapping)
APP_PORT=3000
DB_PORT=5432
REDIS_PORT=6379

# Docker user (run `id -u` and `id -g` to get your values)
UID=1000
GID=1000
