# ===========================================
# Okomo - Variáveis de Ambiente (Exemplo)
# ===========================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env

# Rails
RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true
RAILS_MAX_THREADS=5

# PostgreSQL
POSTGRES_USER=okomo
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=okomo_development
POSTGRES_QUEUE_DB=okomo_development_queue

# Banco de dados usado pela aplicação Rails e pelo Solid Queue
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USERNAME=okomo
DATABASE_PASSWORD=your_secure_password_here
DATABASE_NAME=okomo_development
DATABASE_QUEUE_NAME=okomo_development_queue

# Solid Queue
SOLID_QUEUE_THREADS=3
SOLID_QUEUE_PROCESSES=1

# Redis opcional para cache distribuído ou otimizações futuras.
# REDIS_URL=redis://redis:6379/0

# Portas expostas no host
APP_PORT=3000
DB_PORT=5432
REDIS_PORT=6379

# Usuário Docker (rode `id -u` e `id -g` para obter os valores)
UID=1000
GID=1000
